AppType=StandardJava
Build1=Default,com.puterise.libget.nonui
Group=Default Group
Library1=javaobject
Library2=jcore
Library3=jokhttputils2
Library4=json
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=10.45
@EndOfDesignText@
'Non-UI application (console / server application)
#Region Project Attributes 
#CommandLineArgs:
#MergeLibraries: True
'#Macro: Title, Objects, ide://run?file=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\Objects
'#Macro: Title, Rename, ide://run?file=%COMSPEC%&Args=/c&Args=IF+EXIST+result.jar&Args=ren&Args=result.jar&Args=libget.jar
'#Macro: Title, Build only, ide://run?File=%B4X%\B4JBuilder.exe&Args=-Task%3DBuild&Args=-BaseFolder%3D..&Args=-Obfuscate=False&Args=-Output%3Dlibget
#If Release
#CustomBuildAction: 2, %COMSPEC%, /c copy %PROJECT%\Objects\result.jar %ADDITIONAL%\..\B4X\libget.jar
#End If
#End Region

Sub Process_Globals
	Private AddLibPaths As Map
	Private LibsCount As Int
	Private CheckedCount As Int
	Private RequiredReopen As Boolean = False
	Private RequiredReopen As Boolean
	Type LibItem (Name As String, Platform As String, DownloadLink As String, UpdateLink As String, RequiredVersion As Double)	
End Sub

Sub AppStart (Args() As String)
	Log("libget (v2.60) started...")
	If Args.Length = 0 Then
		Log("Error: Project's path not provided")
		Log("libget ended")
		ExitApplication
	End If
	Dim ProjectDir As String = Args(0)
	Dim UpdateOption As String = "AutoUpdate"
	If Args.Length > 1 Then UpdateOption = Args(1)
	InitializeEnvironment
	RunUpdateProcess(ProjectDir, UpdateOption)
	StartMessageLoop
End Sub

Sub InitializeEnvironment
	AddLibPaths.Initialize
	Dim SystemEnv As Map = getSystemEnvironment
	Dim AppData As String = SystemEnv.GetDefault("APPDATA", "")
	Dim B4JSettingsDir As String = File.Combine(AppData, "Anywhere Software\B4J")
	
	If Not(File.Exists(B4JSettingsDir, "b4xV5.ini")) Then
		Log("Error: B4J configuration not found.")
		ExitApplication
	End If

	' Resolve the Additional Libraries root path
	Dim RootPath As String = ""
	Dim Settings As List = File.ReadList(B4JSettingsDir, "b4xV5.ini")
	For Each Line As String In Settings
		If Line.Contains("AdditionalLibrariesFolder") Then
			RootPath = Line.SubString(Line.IndexOf("=") + 1).Trim
			Exit
		End If
	Next

	If RootPath = "" Then ExitApplication

	' Map Platform-specific folders
	For Each Platform As String In Array("B4A", "B4J", "B4X")
		Dim SpecificPath As String = File.Combine(RootPath, Platform)
		If File.Exists(SpecificPath, "") Then
			AddLibPaths.Put(Platform, SpecificPath)
		Else
			AddLibPaths.Put(Platform, RootPath)
		End If
	Next
End Sub

Sub RunUpdateProcess (Dir As String, Option As String)
	If Not(File.Exists(Dir, "libs.json")) Then
		Log("Error: libs.json not found.")
		Log("libget ended")
		ExitApplication
	End If

	Dim jsonStr As String = File.ReadString(Dir, "libs.json")
	Dim Data As Map = jsonStr.As(JSON).ToMap
	Dim LibList As List = Data.Get("Libraries")
	
	LibsCount = LibList.Size
	If LibsCount = 0 Then ExitApplication

	For Each m As Map In LibList
		Dim Item As LibItem = MapToLibItem(m)
		ProcessLibrary(Item, Option)
	Next
End Sub

Sub ProcessLibrary (Item As LibItem, Option As String)
	Dim TargetPath As String = AddLibPaths.GetDefault(Item.Platform, "")
	If TargetPath = "" Then
		OnLibraryChecked
		Return
	End If

	Dim CurrentVersion As Double = 0
	Dim FileExists As Boolean = File.Exists(TargetPath, Item.Name)
	Dim IsB4xLib As Boolean = Item.Name.EndsWith(".b4xlib")
	
	If FileExists And IsB4xLib Then
		Dim strVer As String = GetB4XLibVersion(File.Combine(TargetPath, Item.Name))
		If IsNumber(strVer) Then CurrentVersion = strVer
		Log($"${Item.Name} found CurrentVersion=${FormatVersion(CurrentVersion)} RequiredVersion=${FormatVersion(Item.RequiredVersion)}"$)
	End If

	Dim NeedsDownload As Boolean = False
	Dim FinalDownloadLink As String = Item.DownloadLink

	If Not(FileExists) Then
		Log($"${Item.Name} not found RequiredVersion=${FormatVersion(Item.RequiredVersion)}"$)
		NeedsDownload = True
		If IsB4xLib Then RequiredReopen = True
	Else
		If IsB4xLib Then
			' Perform version checks only for b4xlibs
			Select Option.ToLowerCase
				Case "forcedowngrade", "true" ' backward compatibility
					If Item.RequiredVersion <> CurrentVersion Then NeedsDownload = True
				Case "autoupdate", "false" ' backward compatibility
					' Standard Update Logic
					If Item.UpdateLink <> "" Then
						Wait For (GetLatestVersion(Item.UpdateLink)) Complete (VersionInfo As Map)
						If VersionInfo.IsInitialized Then
							Dim Newest As Double = VersionInfo.Get("Version")
							If Newest > CurrentVersion Then
								Log($"...Update found: ${FormatVersion(Newest)}"$)
								FinalDownloadLink = VersionInfo.Get("Link")
								NeedsDownload = True
							End If
						Else
							Log($"...Failed to check remote version for ${Item.Name}"$)
						End If
					End If
			
					' Fallback to required version if still older
					If Not(NeedsDownload) And Item.RequiredVersion > CurrentVersion Then
						Log(Item.Name)
						NeedsDownload = True
					End If
				Case Else ' "checkonly"
					NeedsDownload = False
			End Select
		Else
			' Non-b4xlib (jar/xml): Skip version comparison
			Log($"${Item.Name} found RequiredVersion=${FormatVersion(Item.RequiredVersion)}"$)
			'' Only download if forced by the Option argument
			'Select Option.ToLowerCase
			'	Case "forcedowngrade", "true"
			'		Log($"${Item.Name} found RequiredVersion=${FormatVersion(Item.RequiredVersion)}"$)
			'		NeedsDownload = True
			'	Case Else
			'		Log($"${Item.Name} found. Skipping version check."$)
			'		NeedsDownload = False
			'End Select
		End If
	End If

	If NeedsDownload Then
		Wait For (Download(Item.Name, TargetPath, FinalDownloadLink)) Complete (Success As Boolean)
	End If

	OnLibraryChecked
End Sub

' Reads the version from a .b4xlib file (B4A / B4J)
Sub GetB4XLibVersion (LibPath As String) As String
	Dim jZip As JavaObject
	jZip.InitializeNewInstance("java.util.zip.ZipFile", Array(LibPath))
	Dim ZipEntry As JavaObject = jZip.RunMethod("getEntry", Array("manifest.txt"))
	If ZipEntry.IsInitialized Then
		Dim jInputStream As JavaObject = jZip.RunMethod("getInputStream", Array(ZipEntry))
		Dim b() As Byte = Bit.InputStreamToBytes(jInputStream)
		Dim txt As String = BytesToString(b, 0, b.Length, "utf8")
		Dim lines() As String = Regex.Split(CRLF, txt)
		For Each line As String In lines
			If line.StartsWith("Version=") Then
				Return line.SubString(8) ' Extract version number
			End If
		Next
	End If
	Return "Unknown"
End Sub

Sub GetLatestVersion (UpdateLink As String) As ResumableSub
	Log($"Getting version info from ${UpdateLink}..."$)
	Dim VersionInfo As Map
	Dim job As HttpJob
	job.Initialize("", Me)
	job.Download(UpdateLink)
	Wait For (job) JobDone(job As HttpJob)
	If job.Success Then
		Try
			'Log(job.GetString)
			VersionInfo = job.GetString.As(JSON).ToMap
		Catch
			Log(LastException)
		End Try
	Else
		Log(job.ErrorMessage)
	End If
	job.Release
	Return VersionInfo
End Sub

Sub Download (FileName As String, FileDirectory As String, DownloadLink As String) As ResumableSub
	Log($"Downloading ${FileName}..."$)
	Dim success As Boolean
	Dim job As HttpJob
	job.Initialize("", Me)
	job.Download(DownloadLink)
	Wait For (job) JobDone(job As HttpJob)
	If job.Success Then
		Dim out As OutputStream = File.OpenOutput(FileDirectory, FileName, False)
		File.Copy2(job.GetInputStream, out)
		out.Close
		Log($"${FileName} downloaded"$)
		success = True
	Else
		Log(job.ErrorMessage)
	End If
	job.Release
	Return success
End Sub

Sub getSystemEnvironment As Map
	Dim jo As JavaObject
	jo.InitializeStatic("java.lang.System")
	Dim Env As Map = jo.RunMethod("getenv", Null)
	Return Env
End Sub

Sub FormatVersion (Version As Double) As String
	Return NumberFormat2(Version, 1, 2, 2, False)
End Sub

Sub OnLibraryChecked
	CheckedCount = CheckedCount + 1
	If CheckedCount >= LibsCount Then
		Log("libget ended")
		If RequiredReopen Then Log("Note: Please restart your B4X IDE to refresh libraries.")
		ExitApplication
	End If
End Sub

Sub MapToLibItem(m As Map) As LibItem
	Dim li As LibItem
	li.Initialize
	li.Name = m.Get("Name")
	li.Platform = m.Get("Platform")
	li.DownloadLink = m.Get("Link")
	li.UpdateLink = m.GetDefault("Update", "")
	li.RequiredVersion = m.Get("Version")
	Return li
End Sub